# Server Configuration
PORT=8000
HOST=127.0.0.1
DEBUG=True

# Database Configuration
DATABASE_URL=sqlite:///./widget_platform.db

# Security & Multi-Tenancy
API_SECRET_KEY=dev_secret_key_change_in_prod

# Rate Limiting
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_BURST=5

# Geolocation Fallback Simulation
# Set to 'false' to simulate provider downtime in tests/probes
MOCK_GEO_PROVIDER_A_UP=true
MOCK_GEO_PROVIDER_B_UP=true

# Email Side Effect Simulation
# Set to 'false' to simulate email provider downtime in tests/probes
MOCK_EMAIL_SERVICE_UP=true

